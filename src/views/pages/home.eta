<%~ include("../partials/header.eta") %>

    <h2>🐙 Git
        <a href="https://git-scm.com/cheat-sheet" target="_blank"
            style="display:inline-flex; align-items:center; gap:4px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="#00CC88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h6v6" />
                <path d="M10 14 21 3" />
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </svg>
        </a>
    </h2>
    <ul>
        <li><code>git init</code> – Commencer un nouveau dépôt</li>
        <li><code>git clone &lt;url&gt;</code> – Cloner un dépôt</li>
        <li><code>git reset HEAD~x</code> – Annuler les x derniers commits (garde les modifications)</li>
        <li><code>git reset --hard HEAD~x</code> – Annuler les x derniers commits (supprime les modifications)</li>
        <li><code>git push --force</code> – Forcer le push (écrase l'historique distant)</li>
        <li><code>git branch</code> – Afficher les branches locales</li>
        <li><code>git branch &lt;name&gt;</code> – Créer une branche</li>
        <li><code>git status</code> – Afficher la branche courante</li>
        <li><code>git checkout &lt;name&gt;</code> – Changer de branche</li>
        <li><code>git merge &lt;name&gt;</code> – Fusionner une branche</li>
    </ul>

    <h2>🟢 Node.js
        <a href="https://nodejs.org/fr" target="_blank" style="display:inline-flex; align-items:center; gap:4px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="#00CC88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h6v6" />
                <path d="M10 14 21 3" />
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </svg>
        </a>
    </h2>
    <ul>
        <li><code>node -v</code> – Afficher la version de Node</li>
        <li><code>node script.js</code> – Exécuter un script</li>
        <li><code>npm init</code> – Initialiser un projet Node</li>
    </ul>

    <h2>📦 npm
        <a href="https://docs.npmjs.com/cli/v11/commands" target="_blank"
            style="display:inline-flex; align-items:center; gap:4px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="#00CC88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h6v6" />
                <path d="M10 14 21 3" />
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </svg>
        </a>
    </h2>
    <ul>
        <li><code>npm install</code> ou <code>npm i</code> – Installer les dépendances d'un projet</li>
        <li><code>npm install &lt;package&gt;</code> ou <code>npm i &lt;package&gt;</code> – Installer un package</li>
        <li><code>npm install &lt;package&gt; --save-dev</code> ou <code>npm i &lt;package&gt; -D</code> – Installer un package en dépendance de développement</li>
        <li><code>npm uninstall &lt;package&gt;</code> ou <code>npm r &lt;package&gt;</code> – Désinstaller un package</li>
        <li><code>npm outdated</code> – Lister les packages obsolètes</li>
        <li><code>npm update</code> – Mettre à jour les packages obsolètes (sans changer de version majeure)</li>
        <li><code>npm install &lt;package&gt;@latest</code> – Installer ou forcer la dernière version d'un package</li>
        <li><code>npm audit</code> – Scanner les vulnérabilités de sécurité</li>
        <li><code>npm audit fix</code> – Corriger les vulnérabilités de sécurité</li>
        <li><code>npm run &lt;script&gt;</code> – Exécuter un script défini dans package.json</li>
    </ul>

    <h2>💻 PowerShell
        <a href="https://learn.microsoft.com/fr-fr/powershell/" target="_blank"
            style="display:inline-flex; align-items:center; gap:4px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="#00CC88" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h6v6" />
                <path d="M10 14 21 3" />
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </svg>
        </a>
    </h2>
    <ul>
        <li><code>cd &lt;path&gt;</code> – Changer de répertoire</li>
        <li><code>mkdir &lt;folder&gt;</code> – Créer un dossier</li>
        <li><code>code .</code> – Ouvrir un éditeur de code dans le dossier actuel</li>
        <li><code>clear</code> – Vider la console</li>
        <li><code>tree</code> – Arborescence des dossiers</li>
        <li><code>tree /F</code> – Arborescence des dossiers et fichiers</li>
        <li><code>curl &lt;url&gt;</code> – Requête HTTP en GET</li>
        <li><code>curl -o &lt;file.ext&gt; &lt;url&gt;</code> – Récupérer le contenu de la requête dans un fichier</li>
    </ul>

